CONFIG_PACKAGE_luci-app-qmodem=m
CONFIG_PACKAGE_luci-i18n-qmodem-zh-cn=m
# The SDK's default x86 profile selects this legacy kernel package, whose
# out-of-tree build is unavailable in the release SDK. QModem does not use it.
CONFIG_PACKAGE_gpio-button-hotplug=n
CONFIG_PACKAGE_qmodem=m
CONFIG_PACKAGE_qmodem_INCLUDE_SEAL=y
CONFIG_PACKAGE_qmodem_TOM_MODEM_EARLY_RETURN=y
CONFIG_PACKAGE_qmodem_TOM_MODEM_ENABLE_UBUS_DAEMON=y
CONFIG_PACKAGE_qmodem_INCLUDE_generic-qmi-wwan=y
