{
	"admin/modem": {
		"title": "Mobile Network",
		"order": 25,
		"action": {
			"type": "firstchild"
		}
	},
	"admin/modem/qmodem": {
		"title": "Modem Manager",
		"order": 10,
		"action": {
			"type": "firstchild"
		},
		"depends": {
			"acl": [ "luci-app-qmodem" ]
		}
	},

	/*
	 * 菜单整合（2026-10-14）：一级入口从 16 个收敛为 6 个，功能一个不丢——
	 * 相关页面下沉为所属页面的子页签（LuCI 会在页面顶部渲染成 tab）。
	 *   概览 / 移动数据 / 短信 / 模块与 SIM / 网络监控 / 高级
	 * 注意：视图代码里若有硬编码的菜单路径（admin/modem/qmodem/...），
	 * 层级变动后必须同步，见 advanced.js / system.js / status.js。
	 */

	"admin/modem/qmodem/overview": {
		"title": "Overview",
		"order": 1,
		"action": { "type": "view", "path": "qmodem/status" }
	},

	"admin/modem/qmodem/connection": {
		"title": "Mobile Data",
		"order": 2,
		"action": { "type": "view", "path": "qmodem/connection" }
	},
	"admin/modem/qmodem/connection/network_config": {
		"title": "Dial and Network",
		"order": 1,
		"action": { "type": "view", "path": "qmodem/network_config" }
	},
	"admin/modem/qmodem/connection/network": {
		"title": "Radio and Cells",
		"order": 2,
		"action": { "type": "view", "path": "qmodem/network" }
	},

	"admin/modem/qmodem/sms": {
		"title": "Messages",
		"order": 3,
		"action": { "type": "view", "path": "qmodem/sms" }
	},
	"admin/modem/qmodem/sms/conversation/*": {
		"title": "SMS Conversation",
		"action": { "type": "view", "path": "qmodem/sms_conversation" }
	},
	"admin/modem/qmodem/sms/sms_sim": {
		"title": "SIM Messages",
		"order": 8,
		"action": { "type": "view", "path": "qmodem/sms_sim" }
	},
	"admin/modem/qmodem/sms/sms_forward": {
		"title": "SMS Forwarding",
		"order": 9,
		"action": { "type": "view", "path": "qmodem/sms_forward" }
	},

	"admin/modem/qmodem/system": {
		"title": "Module and SIM",
		"order": 4,
		"action": { "type": "view", "path": "qmodem/system" }
	},
	"admin/modem/qmodem/system/sim_switch": {
		"title": "SIM Switch",
		"order": 1,
		"action": { "type": "view", "path": "qmodem/sim_switch" }
	},
	"admin/modem/qmodem/system/device": {
		"title": "Device Parameters",
		"order": 2,
		"action": { "type": "view", "path": "qmodem/device" }
	},

	"admin/modem/qmodem/monitor": {
		"title": "Network Monitor",
		"order": 5,
		"action": { "type": "view", "path": "qmodem/monitor" }
	},
	"admin/modem/qmodem/monitor/terminal": {
		"title": "AT Console",
		"order": 1,
		"action": { "type": "view", "path": "qmodem/terminal" }
	},
	"admin/modem/qmodem/monitor/stats": {
		"title": "Statistics",
		"order": 2,
		"action": { "type": "view", "path": "qmodem/stats" }
	},

	"admin/modem/qmodem/advanced": {
		"title": "Advanced",
		"order": 6,
		"action": { "type": "view", "path": "qmodem/advanced" }
	},
	"admin/modem/qmodem/advanced/modem_config": {
		"title": "Modem Features",
		"order": 1,
		"action": { "type": "view", "path": "qmodem/modem_config" }
	},
	"admin/modem/qmodem/advanced/ttl": {
		"title": "TTL",
		"order": 2,
		"action": { "type": "view", "path": "qmodem/ttl" }
	},
	"admin/modem/qmodem/advanced/service": {
		"title": "Service and Scan",
		"order": 3,
		"action": { "type": "view", "path": "qmodem/service" }
	}
}
