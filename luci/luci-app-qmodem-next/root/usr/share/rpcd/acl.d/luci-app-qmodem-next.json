{
	"luci-app-qmodem-next": {
		"description": "Grant access to QModem Next application",
		"read": {
			"ubus": {
			"qmodem": [
				"base_info", "cell_info", "info", "network_info", "sim_info",
				"get_at_cfg", "get_imei", "get_mode", "get_lockband",
				"get_neighborcell", "get_network_prefer", "get_dns", "get_sms",
				"get_disabled_features", "get_reboot_caps", "get_copyright",
				"dial_status", "get_connect_status", "get_dial_log",
				"get_sim_switch_capabilities", "get_sim_slot",
				"get_pcie_devices", "get_usb_devices", "get_leds",
				"get_network_interfaces", "get_tty_ports", "get_available_devices",
			"get_stats", "get_current_band"
			],
				"qmodem.sms": [
					"status", "config_get", "sync_status", "list", "get", "modem_list", "storage_get"
				],
				"rc" : [ "list" ,"init"],
				"uci": [ "qmodem", "sms_forwarder", "qmodem_ttl" ]
			},
			"uci": [ "qmodem", "sms_forwarder", "qmodem_ttl" ]
		},
		"write": {
			"ubus": {
				"qmodem": [
					"clear_dial_log",
					"clear_stats",
					"delete_sms",
					"do_reboot",
					"modem_dial",
					"modem_hang",
					"modem_redial",
					"remove_modem",
					"scan_all",
					"scan_pcie",
					"scan_usb",
					"send_at",
					"send_raw_pdu",
					"send_sms",
					"set_imei",
					"set_lockband",
					"set_mode",
					"set_neighborcell",
					"set_network_prefer",
					"set_sim_slot",
					"set_sms_storage"
				],
				"qmodem.sms": [
					"configure", "sync", "send", "delete", "mark_read",
					"modem_delete", "storage_set"
				],
				"uci": [ "qmodem", "sms_forwarder", "qmodem_ttl" ]
			},
			"uci": [ "qmodem", "sms_forwarder", "qmodem_ttl" ]
		}
	},
	"luci-mod-status-index": {
		"description": "Grant access to main status display",
		"read": {
			"ubus": {
				"qmodem": [ "cell_info","base_info" ]
			}
		}
	}
}
