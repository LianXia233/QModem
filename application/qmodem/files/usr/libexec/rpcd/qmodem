#!/bin/sh
# RPCD interface for QModem control
# This script provides ubus methods for modem management

. /usr/share/libubox/jshn.sh
. /usr/share/qmodem/generic.sh

TRAFFIC_RESET_CRON_FILE="/etc/crontabs/root"
TRAFFIC_RESET_DEFAULT_ENABLED=0
TRAFFIC_RESET_DEFAULT_TYPE="monthly"
TRAFFIC_RESET_DEFAULT_HOUR=0
TRAFFIC_RESET_DEFAULT_DAY=1
TRAFFIC_RESET_DEFAULT_MINUTE=0

# Validate a UCI section name: non-empty, only [A-Za-z0-9_], max 64 chars
valid_section() {
    case "$1" in
        ''|*[!A-Za-z0-9_]*) return 1 ;;
    esac
    [ "${#1}" -le 64 ]
}

# Extract a field from an RPC JSON payload via jsonfilter.
# Usage: _rpc_field <dot-key> <json>   e.g. _rpc_field config_section "$input"
_rpc_field() {
    printf '%s' "$2" | jsonfilter -e "@.$1"
}

# Extract a field from a JSON payload via jq -r.
# Usage: _rpc_jq <filter> <json>   e.g. _rpc_jq .method "$params"
_rpc_jq() {
    printf '%s' "$2" | jq -r "$1"
}

# Undo one level of jq @sh quoting for a simple token: a bare word, or a
# single-quoted string without embedded single quotes. Rejects anything else
# (e.g. '\''-style sequences) so untrusted tokens can never smuggle shell code.
_sh_unquote() {
    _shu=$1
    case "$_shu" in
        "'"*"'"|"'")
            _shu=${_shu#?}
            _shu=${_shu%?}
            ;;
    esac
    case "$_shu" in
        *"'"*) return 1 ;;
    esac
    printf '%s' "$_shu"
}

# Helper function for caching
try_cache() {
    cache_timeout=$1
    cache_file=$2
    function_name=$3
    current_time=$(date +%s)
    file_time=$(stat -t "$cache_file" 2>/dev/null | awk '{print $14}')
    [ -z "$file_time" ] && file_time=0
    if [ ! -f "$cache_file" ] || [ $((current_time - file_time)) -gt $cache_timeout ]; then
        # Write to a temp file in the same directory, then atomically rename:
        # concurrent RPC calls can never observe a torn/partial cache file.
        cache_tmp=$(mktemp "$cache_file.tmp.XXXXXX") || cache_tmp=""
        if [ -n "$cache_tmp" ]; then
            json_add_array modem_info
            $function_name
            json_close_array
            if json_dump > "$cache_tmp" && mv "$cache_tmp" "$cache_file"; then
                :
            else
                rm -f "$cache_tmp"
            fi
        fi
        cat "$cache_file" 2>/dev/null
    else
        cat "$cache_file"
    fi
}

# Helper function for SMS readback
get_sms() {
    [ -n "$sms_at_port" ] && at_port=$sms_at_port
    cache_timeout=$1
    cache_file=$2
    current_time=$(date +%s)
    file_time=$(stat -t "$cache_file" 2>/dev/null | awk '{print $14}')
    [ -z "$file_time" ] && file_time=0
    get_sms_capabilities
    if [ ! -f "$cache_file" ] || [ $((current_time - file_time)) -gt $cache_timeout ]; then
        # Atomic write: temp file + rename, so concurrent RPC reads never
        # observe a partially written SMS cache.
        sms_tmp=$(mktemp "$cache_file.tmp.XXXXXX") || sms_tmp=""
        if [ -n "$sms_tmp" ]; then
            if tom_modem $use_ubus_flag -d "$at_port" -o r > "$sms_tmp" && mv "$sms_tmp" "$cache_file"; then
                :
            else
                rm -f "$sms_tmp"
            fi
        fi
        echo "$(cat "$cache_file" ; json_dump)" | jq -s 'add'
    else
        echo "$(cat "$cache_file" ; json_dump)" | jq -s 'add'
    fi
}

# Helper function to load vendor-specific script
load_vendor_script() {
    local vendor="$1"
    local vendor_script_prefix="/usr/share/qmodem/vendor"
    local cmds_script_prefix="/usr/share/qmodem/cmds"
    local dynamic_load_json="$vendor_script_prefix/dynamic_load.json"
    local vendor_file="${vendor_script_prefix}/$(jq -r --arg vendor "$vendor" '.[$vendor]' "$dynamic_load_json" 2>/dev/null)"
    
    if [ -z "$vendor" ] || [ ! -f "$vendor_file" ]; then
        . /usr/share/qmodem/generic.sh
    else
        . "$vendor_file"
        local cmds_file="$cmds_script_prefix/$(basename "$vendor_file")"
        if [ -f "$cmds_file" ]; then
            . "$cmds_file"
        fi
    fi
}

# Helper function to get modem configuration
get_modem_config() {
    local section="$1"
    at_port=$(uci get qmodem.$section.at_port 2>/dev/null)
    override_at_port=$(uci get qmodem.$section.override_at_port 2>/dev/null)
    [ -n "$override_at_port" ] && at_port=$override_at_port
    sms_at_port=$(uci -q get qmodem.$section.sms_at_port 2>/dev/null)
    vendor=$(uci get qmodem.$section.manufacturer 2>/dev/null)
    manufacturer="$vendor"
    platform=$(uci get qmodem.$section.platform 2>/dev/null)
    pdp_index=$(uci get qmodem.$section.pdp_index 2>/dev/null)
    [ -z "$pdp_index" ] && pdp_index=$(uci get qmodem.$section.suggest_pdp_index 2>/dev/null)
    use_ubus=$(uci get qmodem.$section.use_ubus 2>/dev/null)
    use_ubus=${use_ubus:-1}
    modem_path=$(uci get qmodem.$section.path 2>/dev/null)
    modem_slot=$(basename "$modem_path" 2>/dev/null)
    
    [ -z "$pdp_index" ] && pdp_index="1"
    [ "$use_ubus" = "1" ] && use_ubus_flag="-u"
}

# Helper function to get AT port configuration (for SMS and AT commands)
get_at_port_config() {
    local section="$1"
    local use_sms_port="$2"
    at_port=$(uci get qmodem.$section.at_port 2>/dev/null)
    override_at_port=$(uci get qmodem.$section.override_at_port 2>/dev/null)
    [ -n "$override_at_port" ] && at_port=$override_at_port
    
    if [ "$use_sms_port" = "1" ]; then
        sms_at_port=$(uci -q get qmodem.$section.sms_at_port 2>/dev/null)
        [ -n "$sms_at_port" ] && at_port=$sms_at_port
    fi
    
    use_ubus=$(uci get qmodem.$section.use_ubus 2>/dev/null)
    use_ubus=${use_ubus:-1}
    [ "$use_ubus" = "1" ] && use_ubus_flag="-u"
}

# Helper function to get vendor information
get_vendor_info() {
    local section="$1"
    vendor=$(uci get qmodem.$section.manufacturer 2>/dev/null)
    platform=$(uci get qmodem.$section.platform 2>/dev/null)
}

# Helper function for AT configuration
get_at_cfg() {
    json_add_object at_cfg
    duns=$(ls /dev/mhi_DUN* 2>/dev/null)
    ttys=$(ls /dev/ttyUSB* 2>/dev/null)
    ttyacms=$(ls /dev/ttyACM* 2>/dev/null)
    wwanNatN=$(ls /dev/wwan* 2>/dev/null | grep -E 'wwan[0-9]at[0-9]')
    all_ttys="$duns $ttys $ttyacms $wwanNatN"
    json_add_array other_ttys
    for tty in $all_ttys; do
        [ -n "$tty" ] && json_add_string "" "$tty"
    done
    json_close_array
    json_add_array ports
    ports=$(uci get qmodem.$config_section.ports 2>/dev/null)
    for port in $ports; do
        json_add_string "" "$port"
    done
    json_close_array
    json_add_array valid_ports
    v_ports=$(uci get qmodem.$config_section.valid_at_ports 2>/dev/null)
    for port in $v_ports; do
        json_add_string "" "$port"
    done
    json_close_array
    override_at_port=$(uci get qmodem.$config_section.override_at_port 2>/dev/null)
    at_port=$(uci get qmodem.$config_section.at_port 2>/dev/null)
    [ -n "$override_at_port" ] && at_port=$override_at_port
    json_add_string using_port "$at_port"
    json_add_array cmds
    
    # Determine language and select appropriate AT commands file
    lang=$(uci get luci.main.lang 2>/dev/null || echo "en")
    case "$lang" in
        zh*|cn|auto)
            at_commands_file="/usr/share/qmodem/at_commands_zh.json"
            ;;
        *)
            at_commands_file="/usr/share/qmodem/at_commands_en.json"
            ;;
    esac
    
    # Fallback to default file if language-specific file doesn't exist
    [ ! -f "$at_commands_file" ] && at_commands_file="/usr/share/qmodem/at_commands.json"
    
    # Each line from jq is "<op>\t<key|@sh>\t<value|@sh>"; the only whitelisted
    # operation is "at_cmd". Tokens are unwrapped by _sh_unquote (strict, no
    # shell interpretation): anything that does not match the whitelist or the
    # simple quoting form is skipped.
    general_cmd=$(jq -rc '.general[]|to_entries| .[] | "at_cmd\t\(.key|@sh)\t\(.value|@sh)"' "$at_commands_file" 2>/dev/null)
    platform_cmd=$(jq -rc ".${vendor}.${platform}[]|to_entries| .[] | \"at_cmd\\t\\(.key|@sh)\\t\\(.value|@sh)\"" "$at_commands_file" 2>/dev/null)
    [ -z "$platform_cmd" ] && platform_cmd=$(jq -rc ".$vendor.general[]|to_entries| .[] | \"at_cmd\\t\\(.key|@sh)\\t\\(.value|@sh)\"" "$at_commands_file" 2>/dev/null)

    tab=$(printf '\t')
    while IFS="$tab" read -r op cmd_key cmd_value; do
        case "$op" in
            at_cmd)
                key=$(_sh_unquote "${cmd_key:-}") || continue
                value=$(_sh_unquote "${cmd_value:-}") || continue
                json_add_object cmd
                json_add_string "name" "$key"
                json_add_string "value" "$value"
                json_close_object
                ;;
            *)
                # Unknown operation: ignored (whitelist dispatch, never executed)
                ;;
        esac
    done <<EOF
$general_cmd
$platform_cmd
EOF
    json_close_array
    json_close_object
    json_dump
}

traffic_reset_fail()
{
    echo "$1" >&2
    exit 1
}

traffic_reset_is_integer()
{
    case "$1" in
        ''|*[!0-9]*)
            return 1
            ;;
        *)
            return 0
            ;;
    esac
}

traffic_reset_normalize_bool()
{
    case "$1" in
        1|true|TRUE|True|yes|on)
            echo "1"
            ;;
        *)
            echo "0"
            ;;
    esac
}

traffic_reset_get_marker()
{
    printf "QMODEM_TRAFFIC_RESET_SECTION='%s'" "$1"
}

traffic_reset_get_line()
{
    local config_section="$1"
    local marker

    marker=$(traffic_reset_get_marker "$config_section")
    [ -f "$TRAFFIC_RESET_CRON_FILE" ] || return 0
    grep -F "$marker" "$TRAFFIC_RESET_CRON_FILE" | head -n 1
}

traffic_reset_remove_old_lines()
{
    local config_section="$1"
    local marker tmp_file

    marker=$(traffic_reset_get_marker "$config_section")
    tmp_file=$(mktemp) || return 1

    if [ -f "$TRAFFIC_RESET_CRON_FILE" ]; then
        grep -Fv "$marker" "$TRAFFIC_RESET_CRON_FILE" > "$tmp_file" || true
    fi

    cat "$tmp_file" > "$TRAFFIC_RESET_CRON_FILE"
    rm -f "$tmp_file"
}

traffic_reset_reload_cron()
{
    /etc/init.d/cron reload >/dev/null 2>&1 || /etc/init.d/cron restart >/dev/null 2>&1
}

traffic_reset_build_line()
{
    local config_section="$1"
    local reset_type="$2"
    local hour="$3"
    local day="$4"
    local minute="$TRAFFIC_RESET_DEFAULT_MINUTE"
    local marker

    marker=$(traffic_reset_get_marker "$config_section")

    if [ "$reset_type" = "daily" ]; then
        printf "%s %s * * * %s ubus call qmodem clear_stats '{\"config_section\":\"%s\"}' >/dev/null 2>&1" \
            "$minute" "$hour" "$marker" "$config_section"
    else
        printf "%s %s %s * * %s ubus call qmodem clear_stats '{\"config_section\":\"%s\"}' >/dev/null 2>&1" \
            "$minute" "$hour" "$day" "$marker" "$config_section"
    fi
}

traffic_reset_dump_json()
{
    local enabled="$1"
    local reset_type="$2"
    local hour="$3"
    local day="$4"
    local minute="$5"
    local line="$6"

    if [ -n "$line" ]; then
        jq -n \
            --argjson enabled "$enabled" \
            --arg reset_type "$reset_type" \
            --argjson hour "$hour" \
            --argjson day "$day" \
            --argjson minute "$minute" \
            --arg line "$line" \
            '{
                enabled: ($enabled == 1),
                reset_type: $reset_type,
                hour: $hour,
                day: $day,
                minute: $minute,
                line: $line
            }'
    else
        jq -n \
            --argjson enabled "$enabled" \
            --arg reset_type "$reset_type" \
            --argjson hour "$hour" \
            --argjson day "$day" \
            --argjson minute "$minute" \
            '{
                enabled: ($enabled == 1),
                reset_type: $reset_type,
                hour: $hour,
                day: $day,
                minute: $minute,
                line: null
            }'
    fi
}

traffic_reset_dump_set_json()
{
    local result="$1"
    local config_section="$2"
    local enabled="$3"
    local reset_type="$4"
    local hour="$5"
    local day="$6"
    local minute="$7"
    local line="$8"

    if [ -n "$line" ]; then
        jq -n \
            --argjson result "$result" \
            --arg config_section "$config_section" \
            --argjson enabled "$enabled" \
            --arg reset_type "$reset_type" \
            --argjson hour "$hour" \
            --argjson day "$day" \
            --argjson minute "$minute" \
            --arg line "$line" \
            '{
                result: $result,
                config_section: $config_section,
                enabled: ($enabled == 1),
                reset_type: $reset_type,
                hour: $hour,
                day: $day,
                minute: $minute,
                line: $line
            }'
    else
        jq -n \
            --argjson result "$result" \
            --arg config_section "$config_section" \
            --argjson enabled "$enabled" \
            --arg reset_type "$reset_type" \
            --argjson hour "$hour" \
            --argjson day "$day" \
            --argjson minute "$minute" \
            '{
                result: $result,
                config_section: $config_section,
                enabled: ($enabled == 1),
                reset_type: $reset_type,
                hour: $hour,
                day: $day,
                minute: $minute,
                line: null
            }'
    fi
}

traffic_reset_get_schedule()
{
    local config_section="$1"
    local enabled reset_type hour day line

    enabled=$(traffic_reset_normalize_bool "$(uci -q get "qmodem.${config_section}.usage_reset_enabled")")
    reset_type=$(uci -q get "qmodem.${config_section}.usage_reset_type")
    hour=$(uci -q get "qmodem.${config_section}.usage_reset_hour")
    day=$(uci -q get "qmodem.${config_section}.usage_reset_day")

    [ -n "$reset_type" ] || reset_type="$TRAFFIC_RESET_DEFAULT_TYPE"
    [ -n "$hour" ] || hour="$TRAFFIC_RESET_DEFAULT_HOUR"
    [ -n "$day" ] || day="$TRAFFIC_RESET_DEFAULT_DAY"

    if [ "$reset_type" != "daily" ] && [ "$reset_type" != "monthly" ]; then
        reset_type="$TRAFFIC_RESET_DEFAULT_TYPE"
    fi

    if ! traffic_reset_is_integer "$hour" || [ "$hour" -lt 0 ] || [ "$hour" -gt 23 ]; then
        hour="$TRAFFIC_RESET_DEFAULT_HOUR"
    fi

    if ! traffic_reset_is_integer "$day" || [ "$day" -lt 1 ] || [ "$day" -gt 31 ]; then
        day="$TRAFFIC_RESET_DEFAULT_DAY"
    fi

    line=$(traffic_reset_get_line "$config_section")
    traffic_reset_dump_json "$enabled" "$reset_type" "$hour" "$day" "$TRAFFIC_RESET_DEFAULT_MINUTE" "$line"
}

traffic_reset_set_schedule()
{
    local input_json="$1"
    local config_section enabled reset_type hour day line cron_backup

    config_section=$(_rpc_field config_section "$input_json")
    enabled=$(traffic_reset_normalize_bool "$(_rpc_field enabled "$input_json")")
    reset_type=$(_rpc_field reset_type "$input_json")
    hour=$(_rpc_field hour "$input_json")
    day=$(_rpc_field day "$input_json")

    [ -n "$config_section" ] || traffic_reset_fail "Missing config_section"
    valid_section "$config_section" || traffic_reset_fail "Invalid config_section"

    case "$reset_type" in
        daily|monthly)
            ;;
        *)
            traffic_reset_fail "Invalid reset_type: $reset_type"
            ;;
    esac

    traffic_reset_is_integer "$hour" || traffic_reset_fail "Invalid hour: $hour"
    [ "$hour" -ge 0 ] && [ "$hour" -le 23 ] || traffic_reset_fail "Hour out of range: $hour"

    traffic_reset_is_integer "$day" || traffic_reset_fail "Invalid day: $day"
    [ "$day" -ge 1 ] && [ "$day" -le 31 ] || traffic_reset_fail "Day out of range: $day"

    cron_backup=$(mktemp) || traffic_reset_fail "Failed to allocate cron backup"
    if [ -f "$TRAFFIC_RESET_CRON_FILE" ]; then
        cat "$TRAFFIC_RESET_CRON_FILE" > "$cron_backup" || {
            rm -f "$cron_backup"
            traffic_reset_fail "Failed to back up traffic reset schedule"
        }
    fi

    traffic_reset_remove_old_lines "$config_section" || {
        rm -f "$cron_backup"
        traffic_reset_fail "Failed to remove old traffic reset schedule"
    }

    uci -q set "qmodem.${config_section}.usage_reset_enabled=$enabled" || {
        cat "$cron_backup" > "$TRAFFIC_RESET_CRON_FILE" 2>/dev/null || true
        rm -f "$cron_backup"
        traffic_reset_fail "Failed to update usage_reset_enabled"
    }
    uci -q set "qmodem.${config_section}.usage_reset_type=$reset_type" || {
        uci -q revert qmodem
        cat "$cron_backup" > "$TRAFFIC_RESET_CRON_FILE" 2>/dev/null || true
        rm -f "$cron_backup"
        traffic_reset_fail "Failed to update usage_reset_type"
    }
    uci -q set "qmodem.${config_section}.usage_reset_hour=$hour" || {
        uci -q revert qmodem
        cat "$cron_backup" > "$TRAFFIC_RESET_CRON_FILE" 2>/dev/null || true
        rm -f "$cron_backup"
        traffic_reset_fail "Failed to update usage_reset_hour"
    }
    uci -q set "qmodem.${config_section}.usage_reset_day=$day" || {
        uci -q revert qmodem
        cat "$cron_backup" > "$TRAFFIC_RESET_CRON_FILE" 2>/dev/null || true
        rm -f "$cron_backup"
        traffic_reset_fail "Failed to update usage_reset_day"
    }

    if [ "$enabled" = "1" ]; then
        line=$(traffic_reset_build_line "$config_section" "$reset_type" "$hour" "$day")
        printf "%s\n" "$line" >> "$TRAFFIC_RESET_CRON_FILE" || {
            uci -q revert qmodem
            cat "$cron_backup" > "$TRAFFIC_RESET_CRON_FILE" 2>/dev/null || true
            rm -f "$cron_backup"
            traffic_reset_fail "Failed to write traffic reset schedule"
        }
    else
        line=""
    fi

    uci commit qmodem || {
        uci -q revert qmodem
        cat "$cron_backup" > "$TRAFFIC_RESET_CRON_FILE" 2>/dev/null || true
        rm -f "$cron_backup"
        traffic_reset_fail "Failed to commit qmodem config"
    }
    traffic_reset_reload_cron || {
        cat "$cron_backup" > "$TRAFFIC_RESET_CRON_FILE" 2>/dev/null || true
        rm -f "$cron_backup"
        traffic_reset_fail "Failed to reload cron service"
    }

    rm -f "$cron_backup"

    traffic_reset_dump_set_json "true" "$config_section" "$enabled" "$reset_type" "$hour" "$day" "$TRAFFIC_RESET_DEFAULT_MINUTE" "$line"
}

# ---------------------------------------------------------------------------
# Modem network-interface traffic stats (next-frontend gap endpoints)
# ---------------------------------------------------------------------------

# Locate the modem network interface for a UCI config section. Uses the same
# mapping as modem_dial.sh (modem path -> net/ subdirectory) and validates the
# candidate against /sys/class/net like get_network_interfaces.
# Sets QMODEM_NETIF (empty when not found).
find_modem_netif()
{
    local section="$1" modem_path net_dir cand
    QMODEM_NETIF=""
    modem_path=$(uci -q get "qmodem.${section}.path" 2>/dev/null)
    [ -n "$modem_path" ] && [ -d "$modem_path" ] || return 0
    net_dir=$(find "$modem_path" -name net 2>/dev/null | tail -n 1)
    [ -n "$net_dir" ] || return 0
    for cand in "$net_dir"/*; do
        [ -e "$cand" ] || continue
        [ -d "/sys/class/net/$(basename "$cand")" ] || continue
        QMODEM_NETIF=$(basename "$cand")
        return 0
    done
}

# Read cumulative counters + uptime for an interface. Sets stats_rx/stats_tx/
# stats_uptime (empty when unavailable or not plain digits).
stats_read_counters()
{
    local iface="$1" up
    stats_rx=$(cat "/sys/class/net/$iface/statistics/rx_bytes" 2>/dev/null)
    stats_tx=$(cat "/sys/class/net/$iface/statistics/tx_bytes" 2>/dev/null)
    case "$stats_rx" in ''|*[!0-9]*) stats_rx="" ;; esac
    case "$stats_tx" in ''|*[!0-9]*) stats_tx="" ;; esac
    stats_uptime=""
    up=$(cut -d ' ' -f 1 /proc/uptime 2>/dev/null)
    up=${up%%.*}
    case "$up" in ''|*[!0-9]*) up="" ;; esac
    stats_uptime="$up"
}

# Read the clear_stats baseline file. Format: "<rx_base> <tx_base> <epoch>".
# Sets stats_base_rx/stats_base_tx (empty when missing/invalid).
stats_read_baseline()
{
    local base_file="/var/run/qmodem/${1}_stats_reset"
    stats_base_rx=""
    stats_base_tx=""
    [ -f "$base_file" ] || return 0
    read stats_base_rx stats_base_tx _ < "$base_file" 2>/dev/null
    case "${stats_base_rx:-}" in ''|*[!0-9]*) stats_base_rx="" ;; esac
    case "${stats_base_tx:-}" in ''|*[!0-9]*) stats_base_tx="" ;; esac
}

# Delta since baseline. Counter wraps (current < baseline, e.g. interface
# rebind or reboot) yield 0 to avoid double counting; a missing baseline
# counts from boot (base 0).
stats_delta()
{
    local cur="$1" base="$2"
    [ -n "$base" ] || { printf '%s' "$cur"; return; }
    if [ "$cur" -ge "$base" ] 2>/dev/null; then
        printf '%s' $((cur - base))
    else
        printf '%s' 0
    fi
}

# get_stats implementation: cumulative values from
# /sys/class/net/<if>/statistics/{rx,tx}_bytes + /proc/uptime timestamp, plus
# increments since the clear_stats baseline (computed here so the frontend
# only renders plain numbers).
get_netif_stats()
{
    local section="$1"
    valid_section "$section" || section=""
    [ -n "$section" ] && find_modem_netif "$section"
    if [ -z "$QMODEM_NETIF" ]; then
        json_add_boolean available 0
        json_add_string interface ""
        return
    fi
    stats_read_counters "$QMODEM_NETIF"
    if [ -z "$stats_rx" ] || [ -z "$stats_tx" ]; then
        json_add_boolean available 0
        json_add_string interface "$QMODEM_NETIF"
        return
    fi
    stats_read_baseline "$section"
    json_add_boolean available 1
    json_add_string interface "$QMODEM_NETIF"
    json_add_int uptime "${stats_uptime:-0}"
    json_add_int updated_at "$(date +%s)"
    json_add_int total_rx_bytes "$stats_rx"
    json_add_int total_tx_bytes "$stats_tx"
    json_add_int rx_bytes "$(stats_delta "$stats_rx" "$stats_base_rx")"
    json_add_int tx_bytes "$(stats_delta "$stats_tx" "$stats_base_tx")"
}

# clear_stats implementation: write the baseline file atomically (mktemp +
# rename), so get_stats deltas restart from the current counters.
clear_netif_stats()
{
    local section="$1" base_file base_tmp
    if ! valid_section "$section"; then
        json_add_boolean result 0
        json_add_string error "invalid config_section"
        return
    fi
    find_modem_netif "$section"
    stats_read_counters "$QMODEM_NETIF"
    if [ -z "$QMODEM_NETIF" ] || [ -z "$stats_rx" ] || [ -z "$stats_tx" ]; then
        json_add_boolean result 0
        json_add_string error "modem interface not found"
        return
    fi
    if ! mkdir -p /var/run/qmodem; then
        json_add_boolean result 0
        json_add_string error "cannot create /var/run/qmodem"
        return
    fi
    base_file="/var/run/qmodem/${section}_stats_reset"
    base_tmp=$(mktemp "$base_file.tmp.XXXXXX") || base_tmp=""
    if [ -n "$base_tmp" ] &&
       printf '%s %s %s\n' "$stats_rx" "$stats_tx" "$(date +%s)" > "$base_tmp" &&
       mv "$base_tmp" "$base_file"; then
        json_add_boolean result 1
        json_add_string interface "$QMODEM_NETIF"
        json_add_int uptime "${stats_uptime:-0}"
        json_add_int total_rx_bytes "$stats_rx"
        json_add_int total_tx_bytes "$stats_tx"
        json_add_int rx_bytes 0
        json_add_int tx_bytes 0
    else
        [ -n "$base_tmp" ] && rm -f "$base_tmp"
        json_add_boolean result 0
        json_add_string error "failed to write baseline"
    fi
}

# ---------------------------------------------------------------------------
# get_current_band (next-frontend flat shape: {rat,band,earfcn,nr_arfcn})
# ---------------------------------------------------------------------------

# Extract one comma-separated field from a QENG line; strips CR, quotes and
# surrounding spaces.
_qeng_field()
{
    printf '%s' "$1" | awk -F',' -v idx="$2" \
        '{ f = $idx; gsub(/\r/, "", f); gsub(/"/, "", f); gsub(/^ +| +$/, "", f); print f }'
}

_qeng_numeric()
{
    case "$1" in
        ''|*[!0-9]*) printf '%s' "" ;;
        *) printf '%s' "$1" ;;
    esac
}

# Parse the QENG "servingcell" response into flat globals (best effort):
# band_rat/band_val/band_earfcn/band_nr_arfcn/band_supported.
# Field layouts follow vendor/quectel.sh and the unisoc testcases fixture:
#   servingcell,"CONNECT","NR5G-SA",<duplex>,<mcc>,<mnc>,<cellid>,<pci>,<x>,
#       <nr-arfcn>,$10,<band>,$11   (unisoc RM500U fixture)
#   servingcell,..,"LTE",<tdd|fdd>,<mcc>,<mnc>,<pci>,<earfcn>,<band>
#   NR5G-NSA line: nr-arfcn at $4, band at $9 (vendor/quectel.sh layout)
parse_current_band()
{
    local resp lte_line sa_line nsa_line wcdma_line f4 f8 f9 f10 f11 nr_arfcn nr_band
    band_rat=""; band_val=""; band_earfcn=""; band_nr_arfcn=""
    band_supported=0
    [ -n "$at_port" ] || return 0
    # Vendor capability gate: only stacks shipping cmd_qeng_servingcell
    # (cmds/quectel.sh) provide the QENG "servingcell" wrapper.
    type cmd_qeng_servingcell >/dev/null 2>&1 || return 0
    resp=$(cmd_qeng_servingcell "$at_port" 2>/dev/null) || return 0
    lte_line=$(printf '%s\n' "$resp" | grep '+QENG: "servingcell"' | grep '"LTE"' | head -n 1)
    sa_line=$(printf '%s\n' "$resp" | grep '+QENG: "servingcell"' | grep '"NR5G-SA"' | head -n 1)
    nsa_line=$(printf '%s\n' "$resp" | grep '+QENG: "NR5G-NSA"' | head -n 1)
    if [ -n "$sa_line" ]; then
        band_rat="NR5G-SA"
        f10=$(_qeng_numeric "$(_qeng_field "$sa_line" 10)")
        f11=$(_qeng_numeric "$(_qeng_field "$sa_line" 11)")
        f8=$(_qeng_numeric "$(_qeng_field "$sa_line" 8)")
        f9=$(_qeng_numeric "$(_qeng_field "$sa_line" 9)")
        if [ -n "$f10" ] && [ -n "$f11" ]; then
            band_nr_arfcn=$f10; band_val=$f11
        else
            band_nr_arfcn=$f8; band_val=$f9
        fi
        band_supported=1
    elif [ -n "$lte_line" ]; then
        band_rat="LTE"
        f4=$(_qeng_field "$lte_line" 4)
        case "$f4" in
            TDD|FDD)
                band_earfcn=$(_qeng_numeric "$(_qeng_field "$lte_line" 8)")
                band_val=$(_qeng_field "$lte_line" 9)
                ;;
            *)
                band_earfcn=$(_qeng_numeric "$(_qeng_field "$lte_line" 7)")
                band_val=$(_qeng_field "$lte_line" 8)
                ;;
        esac
        band_supported=1
    else
        wcdma_line=$(printf '%s\n' "$resp" | grep '+QENG: "servingcell"' | grep '"WCDMA"' | head -n 1)
        if [ -n "$wcdma_line" ]; then
            band_rat="WCDMA"
            # vendor/quectel.sh WCDMA layout: band at $8, UARFCN at $9
            band_val=$(_qeng_field "$wcdma_line" 8)
            band_earfcn=$(_qeng_numeric "$(_qeng_field "$wcdma_line" 9)")
            band_supported=1
        fi
    fi
    if [ -n "$nsa_line" ]; then
        [ -n "$band_rat" ] && band_rat="EN-DC" || band_rat="NR5G-NSA"
        nr_arfcn=$(_qeng_numeric "$(_qeng_field "$nsa_line" 4)")
        nr_band=$(_qeng_field "$nsa_line" 9)
        [ -n "$nr_arfcn" ] && band_nr_arfcn=$nr_arfcn
        [ -n "$nr_band" ] && [ -z "$band_val" ] && band_val=$nr_band
        band_supported=1
    fi
}

# try_cache callback: append the flat band object as a modem_info element.
current_band_query()
{
    parse_current_band
    json_add_object ""
    json_add_boolean supported "$band_supported"
