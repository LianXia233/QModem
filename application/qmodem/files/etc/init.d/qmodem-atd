#!/bin/sh /etc/rc.common

# qmodem-atd：Rust AT 守护进程（unix socket JSON 协议）。
# 启动时按 /etc/config/qmodem-atd 的 port 段逐个登记串口。
# 注意：默认 enabled=0；把 qmodem.main.at_tool 切到 2 之前必须先启用本服务。

START=98
STOP=10

USE_PROCD=1
PROG=/usr/bin/qmodem-atd

qmodem_atd_add_port()
{
	local section="$1"
	local at_port
	at_port=$(config_get "$section" at_port)
	[ -n "$at_port" ] || return 0
	# baudrate / databits / parity / stopbits 目前未接入 atd（AtPortConfig::default）
	qmodem_atd_args="$qmodem_atd_args --port $at_port"
}

start_service()
{
	local enabled socket
	enabled=$(uci -q get qmodem-atd.main.enabled 2>/dev/null)
	[ "$enabled" = "1" ] || return 0

	socket=$(uci -q get qmodem-atd.main.socket 2>/dev/null)
	[ -n "$socket" ] || socket="/var/run/qmodem/atd.sock"

	qmodem_atd_args="--socket $socket"
	config_load qmodem-atd
	config_foreach qmodem_atd_add_port port

	mkdir -p "$(dirname "$socket")"

	procd_open_instance
	procd_set_param command $PROG $qmodem_atd_args
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers()
{
	procd_add_reload_trigger "qmodem-atd"
}

reload_service()
{
	stop
	start
}
