#!/bin/sh /etc/rc.common

# qmodem-atd：Rust AT 守护进程（unix socket JSON 协议），at_tool 的默认通路。
# 端口来源（按优先级）：
#   1) /etc/config/qmodem-atd 里显式声明的 `config port` 段；
#   2) 未声明任何 port 段时，自动收集 /etc/config/qmodem 各 modem-device 的
#      at_port，使开箱即用。
# 注意：baudrate / databits / parity / stopbits 目前由守护进程以默认配置打开
# （AtPortConfig::default），待 atd 实现配置加载后接入。

START=98
STOP=10

USE_PROCD=1
PROG=/usr/bin/qmodem-atd

qmodem_atd_collect_port()
{
	local at_port="$1"
	[ -n "$at_port" ] || return 0
	case " $qmodem_atd_ports " in
		*" $at_port "*) return 0 ;;
	esac
	qmodem_atd_ports="$qmodem_atd_ports $at_port"
}

qmodem_atd_port_section()
{
	local section="$1"
	qmodem_atd_collect_port "$(config_get "$section" at_port)"
}

# 注意：UCI 里 `config modem-device '2_1'` 的 "modem-device" 是**节类型**而不是
# option，config_get "$section" type 取不到值；config_foreach 的第二个参数已经
# 按节类型过滤，这里不能再做 type 判断，否则永远收集不到端口（实机表现为
# 未显式配置 port 段时 atd 完全不启动）。
qmodem_atd_modem_section()
{
	local section="$1"
	qmodem_atd_collect_port "$(config_get "$section" at_port)"
}

# 独占约束：AT 串口只允许 qmodem-atd 持有。C 版 ubus-at-daemon 会直接打开同一
# tty，两者并存时应答互相被偷（实机实测：atd 收到的 lines 恒为空，形似"AT 超时"）。
# 因此在启动前主动停止并停用遗留守护进程。
qmodem_atd_ensure_exclusive()
{
	local legacy="/etc/init.d/ubus-at-daemon"
	[ -x "$legacy" ] || return 0
	"$legacy" running >/dev/null 2>&1 && "$legacy" stop >/dev/null 2>&1
	"$legacy" enabled >/dev/null 2>&1 && "$legacy" disable >/dev/null 2>&1
	return 0
}

start_service()
{
	local enabled socket

	qmodem_atd_ensure_exclusive
	enabled=$(uci -q get qmodem-atd.main.enabled 2>/dev/null)
	[ "$enabled" = "1" ] || return 0

	socket=$(uci -q get qmodem-atd.main.socket 2>/dev/null)
	[ -n "$socket" ] || socket="/var/run/qmodem/atd.sock"

	qmodem_atd_ports=""
	config_load qmodem-atd
	config_foreach qmodem_atd_port_section port

	# 未显式声明 port 段时，从 qmodem 的 modem-device 收集 AT 口（开箱即用）
	if [ -z "$qmodem_atd_ports" ]; then
		config_load qmodem
		config_foreach qmodem_atd_modem_section modem-device
	fi

	if [ -z "$qmodem_atd_ports" ]; then
		echo "qmodem-atd: no AT port found (set /etc/config/qmodem-atd port sections)" >&2
		return 0
	fi

	# 只保留当前真实存在的 tty 节点：写死/过期的端口段不应把守护进程带偏
	#
	# （端口顺序保持 UCI 收集顺序，去重已在 collect_port 内完成）
	local _keep="" _p
	for _p in $qmodem_atd_ports; do
		if [ -c "$_p" ]; then
			_keep="$_keep $_p"
		else
			echo "qmodem-atd: skip missing tty $_p" >&2
		fi
	done
	qmodem_atd_ports="$_keep"
	if [ -z "$qmodem_atd_ports" ]; then
		echo "qmodem-atd: no existing AT port among configured values" >&2
		return 0
	fi
	echo "qmodem-atd: ports$qmodem_atd_ports" >&2

	qmodem_atd_args="--socket $socket"
	for p in $qmodem_atd_ports; do
		qmodem_atd_args="$qmodem_atd_args --port $p"
	done

	mkdir -p "$(dirname "$socket")"

	procd_open_instance
	procd_set_param command $PROG $qmodem_atd_args
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers()
{
	procd_add_reload_trigger "qmodem-atd"
	procd_add_reload_trigger "qmodem"
}

reload_service()
{
	stop
	start
}
