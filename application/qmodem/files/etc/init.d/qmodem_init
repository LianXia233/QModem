#!/bin/sh /etc/rc.common
START=80
STOP=30
USE_PROCD=1

. $IPKG_INSTROOT/lib/functions.sh

# create the qmodem system group used by modem_scand's control socket (0660).
# NOTE: on real builds this is better handled in the package postinst;
# this runtime fallback keeps the group present on upgrades/existing systems.
_ensure_qmodem_group()
{
    if ! grep -q "^qmodem:" /etc/group 2>/dev/null; then
        local gid
        gid=$(( $(cut -d: -f3 /etc/group 2>/dev/null | sort -n | tail -n 1) + 1 ))
        echo "qmodem:x:${gid}" >> /etc/group && \
            logger -t qmodem_init "created system group qmodem (gid ${gid})"
    fi
}

# one-shot locked scan runner: flock serializes the untracked background
# children spawned below so identical scans never overlap
_locked_oneshot()
{
    local delay="$1" tag="$2"
    shift 2
    (
        sleep "$delay"
        mkdir -p /var/run/qmodem
        if command -v flock >/dev/null 2>&1 && flock -w 120 /var/run/qmodem/scan.lock; then
            logger -t qmodem_init "${tag} scan start"
            "$@"
            logger -t qmodem_init "${tag} scan done"
        else
            logger -t qmodem_init "${tag} scan skipped: /var/run/qmodem/scan.lock busy"
        fi
    ) &
}

start_service() {
    _ensure_qmodem_group
	config_load qmodem
    _start_scand
    config_foreach _mk_rundir modem-device
    config_get block_auto_probe main block_auto_probe 0
    config_get enable_pcie_scan main enable_pcie_scan 0
    config_get enable_usb_scan main enable_usb_scan 0
    config_get try_preset_usb main try_preset_usb 1
    config_get try_preset_pcie main try_preset_pcie 1
    #once enabled, skip all check or scan
    [ "${block_auto_probe:-0}" -eq 1 ] && return

    #enabled by default
    if [ "$try_preset_pcie" -eq 1 ];then
        _try_vendor_preset_pcie
    fi
    if [ "$try_preset_usb" -eq 1 ];then
        _try_vendor_preset_usb
    fi

    #not enabled by default
    if [ "$enable_usb_scan" -eq 1 ];then
        _scan_usb
    fi
    if [ "$enable_pcie_scan" -eq 1 ];then
        _scan_pcie
    fi
}

boot() {
    local delay
    delay=$(uci -q get qmodem.main.start_delay || echo 0)
    if [ "$delay" -gt 0 ]; then
        logger -t qmodem_init "Delay QModem Boot init scan for $delay S"
        _locked_oneshot "$delay" "boot-delayed" /usr/share/qmodem/modem_scan.sh scan
    fi
    start
}

_try_vendor_preset_usb()
{
    config_foreach _try_usb_device modem-device
    config_foreach _try_usb_slot modem-slot
}

_try_vendor_preset_pcie()
{
    config_foreach _try_pcie_device modem-device
    config_foreach _try_pcie_slot modem-slot
}

_try_pcie_slot()
{
    config_get type "$1" type
    [ "$type" = "pcie" ] && _try_slot $1
}

_try_usb_slot()
{
    config_get type "$1" type
    [ "$type" = "usb" ] && _try_slot $1
}

_try_usb_device()
{
    config_get data_interface $1 data_interface
    [ "$data_interface" = "usb" ] && _try_device $1
}

_try_pcie_device()
{
    config_get data_interface $1 data_interface
    [ "$data_interface" = "pcie" ] && _try_device $1
}

_scan_usb()
{
    _locked_oneshot 15 "scan-usb" /usr/bin/modem_scanc scan usb
}

_scan_pcie()
{
    _locked_oneshot 15 "scan-pcie" /usr/bin/modem_scanc scan pcie
}

_start_scand()
{
    config_get scan_log_level main scan_log_level info
    procd_open_instance "scand"
    procd_set_param command "/usr/bin/modem_scand"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param env QMODEM_SCAN_LOG_LEVEL="$scan_log_level"
    procd_close_instance
}

_mk_rundir()
{
    modem_cfg="$1"
    mkdir -p "/var/run/qmodem/${modem_cfg}_dir"
}

_try_slot()
{
    config_get slot "$1" slot
    config_get type "$1" type
    case "$type" in
        usb)
            path="/sys/bus/usb/devices/${slot}"
            ;;
        pcie)
            path="/sys/bus/pci/devices/${slot}"
            ;;
    esac

    if [ -d "$path" ]; then
        logger -t modem_init "try modem $1"
        _locked_oneshot 1 "slot-$1-add" /usr/share/qmodem/modem_scan.sh add "$slot" "$type"
    else
        _locked_oneshot 1 "slot-$1-disable" /usr/share/qmodem/modem_scan.sh disable "$slot"
    fi
}

_try_device()
{
    config_get path "$1" path
    config_get network "$1" network
    config_get slot "$1" slot
    [ -n "$slot" ] || slot=$(basename "$path")
    config_get data_interface "$1" data_interface
    if [ ! -d "$path" ]; then
        _locked_oneshot 1 "device-$slot-disable" /usr/share/qmodem/modem_scan.sh disable "$slot"
        return
    fi
    # if device_path is not parent of netdevice_path, disable device path and scan again
    network=$(/usr/share/qmodem/modem_netdev.sh "$1")
    netdevice_path=$(readlink -f "/sys/class/net/$network/device/")
    device_path=`readlink -f $path`
    echo "$netdevice_path" | grep -q "^$device_path"
    is_parent=$?
    if [ "$is_parent" -ne 0 ] || [ ! -d "$netdevice_path" ]; then
        _locked_oneshot 1 "device-$slot-disable" /usr/share/qmodem/modem_scan.sh disable "$slot"
        _locked_oneshot 1 "device-$slot-add" /usr/share/qmodem/modem_scan.sh add "$(basename "$path")" "$data_interface"
    fi
}
